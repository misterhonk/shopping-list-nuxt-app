#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Führe Tests vor dem Push durch..."
npm run validate

echo "🔒 Führe Sicherheitsüberprüfungen durch..."
npm run audit:security || {
  echo "⚠️ Sicherheitslücken gefunden. Bitte überprüfen Sie den npm audit-Bericht."
  echo "⚠️ Wenn Sie trotzdem pushen möchten, verwenden Sie 'git push --no-verify'"
  exit 1
}
