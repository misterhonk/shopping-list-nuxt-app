import { defineNuxtPlugin } from '#app';
import { CategoryEventBus } from '../composables/types';

/**
 * Plugin zur Bereitstellung des Kategorie-Update-Events
 * Ermöglicht die Synchronisierung von Kategorienamen zwischen Store und Items
 */
export default defineNuxtPlugin(() => {
  // Einfacher Event-Bus für Kategorieänderungen
  const callbacks: Array<(categoryId: string, newName: string) => void> = [];
  
  const categoryEventBus: CategoryEventBus = {
    on(callback) {
      callbacks.push(callback);
      return () => {
        const index = callbacks.indexOf(callback);
        if (index !== -1) {
          callbacks.splice(index, 1);
        }
      };
    },
    emit(categoryId, newName) {
      callbacks.forEach(callback => callback(categoryId, newName));
    }
  };
  
  return {
    provide: {
      onCategoryUpdate: categoryEventBus.on,
      emitCategoryUpdate: categoryEventBus.emit
    }
  };
});
