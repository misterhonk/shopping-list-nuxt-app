import { defineNuxtPlugin } from '#app';
import { createLogger } from '../utils/logger';

/**
 * Plugin für zentralisiertes Logging in der App
 * Stellt eine $getLogger-Funktion bereit, die in Komponenten verwendet werden kann
 */
export default defineNuxtPlugin(nuxtApp => {
  // Logger für das Plugin selbst
  const pluginLogger = createLogger('logger-plugin');
  pluginLogger.info('Logger-Plugin initialisiert');

  /**
   * Liefert einen Logger für eine bestimmte Komponente oder Modul
   * @param module - Name des Moduls/der Komponente
   * @returns Ein konfigurierter Logger
   */
  const getLogger = (module: string) => {
    return createLogger(module);
  };

  // Stelle die Funktionalität global zur Verfügung
  return {
    provide: {
      getLogger,
    },
  };
});
